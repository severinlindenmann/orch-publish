# One orch-apps app. %i is the slug; run.sh and env are generated by orch-apps-host from the app's app.toml.
[Unit]
Description=orch-apps app %i
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=orch-apps-data/%i
EnvironmentFile=/srv/orch-apps/apps/%i/env
ExecStart=/srv/orch-apps/apps/%i/run.sh
Restart=on-failure
RestartSec=3

MemoryMax=128M
MemorySwapMax=0
CPUQuota=25%
TasksMax=64

UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
